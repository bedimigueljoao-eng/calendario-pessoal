<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/alarmBackground"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <!-- Top spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Pulsing Alarm Badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#26FFFFFF"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvAlarmBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏰ HORÁRIO DE ESTUDO"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <!-- Large Time Display -->
    <TextView
        android:id="@+id/tvClockTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="08:00"
        android:textColor="@color/alarmText"
        android:textSize="64sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <!-- Discipline Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@color/alarmCard"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvDisciplineName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disciplina"
            android:textColor="@color/alarmText"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvScheduleRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Sessão programada: 08:00 - 09:30"
            android:textColor="@color/alarmSubtext"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvAlarmNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="O toque continuará ativo até selecionar uma das opções abaixo."
            android:textColor="#FBBF24"
            android:textSize="12sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Middle spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gap="12dp">

        <!-- Button 1: ESTUDAR -->
        <Button
            android:id="@+id/btnStudy"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/btnStudy"
            android:text="▶ ESTUDAR AGORA"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Button 2: ADIAR -->
        <Button
            android:id="@+id/btnSnooze"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/btnSnooze"
            android:text="⏱ ADIAR (10 MIN)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Quick Snooze Options Container (Expandable or Quick Chips) -->
        <LinearLayout
            android:id="@+id/layoutSnoozeChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnSnooze5"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="5m"
                android:textColor="#FBBF24"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSnooze10"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="10m"
                android:textColor="#FBBF24"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSnooze15"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="15m"
                android:textColor="#FBBF24"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSnooze30"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="30m"
                android:textColor="#FBBF24"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Button 3: NÃO ESTUDAR -->
        <Button
            android:id="@+id/btnSkip"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="✕ NÃO ESTUDAR"
            android:textColor="#F87171"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="16dp" />

</LinearLayout>
